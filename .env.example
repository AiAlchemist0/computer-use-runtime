# Any tool-calling provider. Tests and --llm fake need none of these.
LLM_PROVIDER=fake
LLM_MODEL=fake
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# VENICE_API_KEY=
# VENICE_BASE_URL=https://api.venice.ai/api/v1
# Hosted briefing chat and live discover use z.ai GLM-5.3-Flash on the same API.
# Put the key only in apps/worker/zai-api-key.local.txt (gitignored),
# then: wrangler secret put ZAI_API_KEY
# Never put a key in the site or wrangler.jsonc. Matcher works without it.
# Discover can use the same key: LLM_PROVIDER=zai LLM_MODEL=glm-5.3-flash
# ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
BANK_PORT=4177
DEMO_ENABLED=true
