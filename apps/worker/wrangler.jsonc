{
  "name": "computer-use-runtime",
  "account_id": "fd3c1d3bddf094ff49d409326ba2c2ee",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "SessionCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionCoordinator"] }],
  "vars": {
    "DEMO_ENABLED": "true",
    "DAILY_SESSION_BUDGET": "40",
    "LLM_PROVIDER": "zai",
    "LLM_MODEL": "glm-5.3-flash",
    "ZAI_BASE_URL": "https://api.z.ai/api/paas/v4"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "interface.deanshev.com", "custom_domain": true, "zone_name": "deanshev.com" }
  ]
}