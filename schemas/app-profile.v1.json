{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "vendorProduct": {
      "type": "string"
    },
    "entry": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "url",
            "role_name",
            "text",
            "title"
          ]
        },
        "value": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "sessionExpired": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "url",
            "role_name",
            "text",
            "title"
          ]
        },
        "value": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "interstitials": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "detect": {
            "type": "object",
            "properties": {
              "candidates": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "strategy": {
                      "type": "string",
                      "enum": [
                        "role_name",
                        "label",
                        "text",
                        "nth_role",
                        "css"
                      ]
                    },
                    "role": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "nth": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "css": {
                      "type": "string"
                    },
                    "weak": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "strategy",
                    "weak"
                  ],
                  "additionalProperties": false
                }
              },
              "fingerprint": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "nearbyText": {
                    "type": "string"
                  },
                  "candidateCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "framePath": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "candidateCount",
                  "framePath"
                ],
                "additionalProperties": false
              },
              "framePath": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "candidates",
              "fingerprint",
              "framePath"
            ],
            "additionalProperties": false
          },
          "dismiss": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "click",
                  "press"
                ]
              },
              "target": {
                "type": "object",
                "properties": {
                  "candidates": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "strategy": {
                          "type": "string",
                          "enum": [
                            "role_name",
                            "label",
                            "text",
                            "nth_role",
                            "css"
                          ]
                        },
                        "role": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "nth": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "css": {
                          "type": "string"
                        },
                        "weak": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "strategy",
                        "weak"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "fingerprint": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "nearbyText": {
                        "type": "string"
                      },
                      "candidateCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "framePath": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "candidateCount",
                      "framePath"
                    ],
                    "additionalProperties": false
                  },
                  "framePath": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "candidates",
                  "fingerprint",
                  "framePath"
                ],
                "additionalProperties": false
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "detect",
          "dismiss"
        ],
        "additionalProperties": false
      }
    },
    "errorPatterns": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "pattern"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "vendorProduct",
    "entry",
    "interstitials",
    "errorPatterns"
  ],
  "additionalProperties": false
}
